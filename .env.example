# .env.example — copy this to .env and fill in real values

# ── Flask Security
# CRITICAL: Change this to a secure random 32-character string in production!
# e.g., generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secure-random-secret-key
FLASK_ENV=development

# ── Email (Gmail SMTP)
# 1. Enable 2FA on your Gmail account
# 2. Go to: myaccount.google.com/apppasswords
# 3. Generate an App Password (select "Mail" + "Windows Computer")
# 4. Paste it below (no spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=EMS

# ── App configuration
# Base URL for email verification links (no trailing slash)
APP_BASE_URL=http://127.0.0.1:5000
DATABASE_PATH=database.db
CORS_ORIGINS=http://127.0.0.1:5000

# ── MongoDB Atlas ──────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@your-cluster.mongodb.net/ems_db?retryWrites=true

# ── Monitoring & Observability (Optional)
SENTRY_DSN=

# ── JWT Configuration (Optional/Legacy)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7


