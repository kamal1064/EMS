# Server Configuration
PORT=5000

# Database Configuration
# Replace with your real MongoDB Atlas connection string!
MONGO_URI=mongodb+srv://username:password@your-cluster.mongodb.net/google_auth_ems?retryWrites=true&w=majority

# Express Session Hashing Secret
# Generate a secure 32-character key for production!
SESSION_SECRET=your-session-hashing-secret-key-goes-here

# Google OAuth 2.0 Credentials
# Get these from: console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
